<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Form hóa đơn.

         Mọi mốc xpath dưới đây đều là mốc mà account_debit_note đang dùng, nên
         chắc chắn tồn tại: button[@name='action_reverse'] và
         page[@id='other_tab']. Không dùng field 'ref' như bản spec đề xuất vì
         mốc đó chưa được kiểm chứng.
         ===================================================================== -->
    <record id="view_move_form_adjustment" model="ir.ui.view">
        <field name="name">account.move.form.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- 0. Hộp xác nhận trước khi vào sổ.

                 Vào sổ là một chiều: module này chặn Đặt lại nháp trên hóa đơn
                 bán đã vào sổ, nên bấm nhầm là phải đi cả quy trình điều chỉnh.

                 XPath phải phân biệt được HAI nút cùng name="action_post" trong
                 header của core: string="Post" cho bút toán thường
                 (account/views/account_move_views.xml:704) và string="Confirm"
                 cho hóa đơn (:708). Viết
                 <button name="action_post" position="attributes"> sẽ dính nút
                 đầu tiên, tức nút bút toán thường - sai chỗ.

                 KHÔNG lọc được bằng @string: Odoo cấm mọi attribute dịch được
                 làm selector (TRANSLATED_ATTRS trong odoo/tools/translate.py:75
                 gồm string, help, title, label, confirm, confirm-title...).
                 Dùng @string sẽ lỗi lúc cài: "View inheritance may not use
                 attribute 'string' as a selector."

                 Hai nút chỉ khác nhau ở @string và @invisible, nên lọc theo
                 @invisible. Biến display_inactive_currency_warning chỉ xuất hiện
                 ở nút Confirm, là dấu nhận dạng duy nhất và ổn định.

                 confirm / confirm-title / confirm-label là cơ chế có sẵn của web
                 client (web/static/src/views/view_button/view_button_hook.js:118),
                 không cần Python. Hộp hiện hoàn toàn ở client: bấm Hủy thì không
                 có request nào tới server.

                 Lưu ý: confirm là attribute TĨNH, không điều kiện theo move_type
                 được, nên hộp này áp cho cả hóa đơn bán lẫn hóa đơn mua. -->
            <xpath expr="//header/button[@name='action_post'][contains(@invisible, 'display_inactive_currency_warning')]"
                   position="attributes">
                <attribute name="confirm-title">Vào sổ hóa đơn</attribute>
                <attribute name="confirm">Sau khi vào sổ, hóa đơn không sửa được nữa — mọi thay đổi phải lập chứng từ điều chỉnh. Kiểm tra lại khách hàng, dòng hàng và thuế trước khi tiếp tục.</attribute>
                <attribute name="confirm-label">Vào sổ</attribute>
            </xpath>

            <!-- 1. Nút gộp, đặt TRƯỚC nút Giấy báo có của core. -->
            <button name="action_reverse" position="before">
                <button name="action_open_adjustment_wizard" type="object"
                        string="Điều chỉnh hóa đơn" class="btn-primary"
                        groups="account.group_account_invoice"
                        invisible="move_type not in ('out_invoice', 'in_invoice') or state != 'posted'"
                        data-hotkey="shift+a"/>
            </button>

            <!-- 2. Hai nút gốc lùi về nhóm Kế toán trưởng. Ẩn bớt chứ không
                 xóa: giữ đường thoát khi wizard chưa cover hết tình huống. -->
            <button name="action_reverse" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </button>
            <button name="action_debit_note" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </button>

            <!-- 2b. Ẩn nút "Yêu cầu hủy".

                 Nút này không do module tạo ra: core hiện nó đúng lúc
                 _need_cancel_request bật và "Đặt lại nháp" ẩn đi
                 (account/views/account_move_views.xml:782). Nó là hook chờ
                 localization cắm tích hợp cơ quan thuế vào, mà ta không có —
                 core để method rỗng nên bấm vào không có phản ứng gì.

                 Hủy hóa đơn đã phát hành là nghiệp vụ khác hẳn điều chỉnh
                 (Mẫu 04/SS-HĐĐT, không sinh chứng từ thay thế), nên không trỏ
                 nó sang wizard điều chỉnh. Kế toán viên chỉ còn đường Điều
                 chỉnh hóa đơn; muốn hủy thật thì nhờ kế toán trưởng.

                 invisible="1" chứ không position="replace": ẩn mềm, module
                 khác vẫn xpath được vào nút. -->
            <button name="button_request_cancel" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <!-- 3. Metadata điều chỉnh, group riêng trong tab "Thông tin khác".

                 KHÔNG chèn sau field invoice_origin: field đó nằm trong
                 group[@id='sale_info_group'], mà group đó invisible khi
                 move_type not in ('out_invoice','out_refund') — metadata sẽ
                 biến mất trên hóa đơn mua. Group riêng thì hiện đúng ở mọi
                 loại chứng từ và tự ẩn khi không phải chứng từ điều chỉnh. -->
            <xpath expr="//page[@id='other_tab']/group[@id='other_tab_group']" position="inside">
                <group string="Điều chỉnh hóa đơn" name="adjustment_group"
                       invisible="not adjustment_type and not replacement_origin_id">
                    <field name="adjustment_type" readonly="1"
                           invisible="not adjustment_type"/>
                    <field name="replacement_origin_id" readonly="1"
                           invisible="not replacement_origin_id"/>
                    <field name="adjustment_agreement_name" readonly="1"
                           invisible="not adjustment_agreement_name"/>
                    <field name="adjustment_agreement_date" readonly="1"
                           invisible="not adjustment_agreement_date"/>
                </group>
            </xpath>

        </field>
    </record>

    <!-- =====================================================================
         List hóa đơn: cột Loại điều chỉnh, ẩn mặc định.

         Cần thiết vì chứng từ điều chỉnh thông tin có giá trị 0 sẽ mang nhãn
         "Đã thanh toán" ngay khi vào sổ (_compute_payment_state: residual = 0
         và không có payment -> paid). Không có cột này thì không phân biệt
         được bằng mắt với hóa đơn đã thu tiền thật.
         ===================================================================== -->
    <record id="view_invoice_tree_adjustment" model="ir.ui.view">
        <field name="name">account.move.list.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_origin" position="after">
                <field name="adjustment_type" optional="hide"
                       string="Loại điều chỉnh"/>
            </field>
        </field>
    </record>

    <!-- Filter soát cuối kỳ: mọi chứng từ điều chỉnh. -->
    <record id="view_account_invoice_filter_adjustment" model="ir.ui.view">
        <field name="name">account.invoice.select.adjustment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="out_refund" position="after">
                <filter string="Chứng từ điều chỉnh" name="adjustment_filter"
                        domain="[('adjustment_type', '!=', False)]"/>
            </filter>
        </field>
    </record>

</odoo>
