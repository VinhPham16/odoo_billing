<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_rate_inverse" model="ir.ui.view">
        <field name="name">account.move.form.rate.inverse</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!--
                Đảo chiều hiển thị tỷ giá:
                    core:  1 VND = 0.000039 USD
                    mới:   25.820,00 VND = 1 USD

                Dùng position="replace" vì mục tiêu là đảo bố cục của chính
                khối này - không có dạng kế thừa nhẹ hơn làm được việc đó.
                Đánh đổi: nếu bản Odoo sau sửa khối gốc thì thay đổi của core
                bị bản này che mất. Khối chỉ vài dòng nên dễ đối chiếu khi
                nâng cấp; bản gốc ở account/views/account_move_views.xml,
                div[@name='currency_conversion_div'].
            -->
            <xpath expr="//div[@name='currency_conversion_div']" position="replace">
                <div name="currency_conversion_div"
                     class="d-flex gap-1 text-muted"
                     invisible="currency_id == company_currency_id">
                    <!--
                        BẮT BUỘC giữ invoice_currency_rate trong view: hai chỗ
                        khác của core tham chiếu nó trong biểu thức modifier
                        (div[@name='in_and_refresh_button_div'] và nút refresh
                        ngay bên dưới), bỏ field đi là view lỗi.
                    -->
                    <field name="invoice_currency_rate" invisible="1"/>
                    <field name="invoice_currency_rate_inverse"
                           digits="[16, 2]"
                           readonly="state != 'draft'"
                           style="width: auto;"/>
                    <field name="company_currency_id" readonly="True"
                           options="{'no_open': True}" class="w-auto"/>
                    <span>=</span>
                    <span>1</span>
                    <field name="currency_id" readonly="True"
                           options="{'no_open': True}" class="w-auto"/>
                    <div invisible="show_journal or state != 'draft' or invoice_currency_rate == expected_currency_rate">
                        <button type="object"
                                name="refresh_invoice_currency_rate"
                                icon="fa-refresh"
                                title="Reset the currency rate to the default accordingly to the invoice date"
                                class="btn btn-link p-0"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
