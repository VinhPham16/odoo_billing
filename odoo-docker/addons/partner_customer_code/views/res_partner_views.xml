<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =====================================================================
         Form khách hàng: thêm group "Phân loại khách hàng" gom
         Loại khách hàng + Mã số thuế + Mã khách hàng.

         QUAN TRỌNG: group gốc bên phải (function/vat/website/lang/category_id)
         chỉ chứa field. KHÔNG được chèn <group> lồng vào trong đó (trộn field +
         group con làm Odoo vỡ cột nhãn -> mất title các field cũ). Vì vậy group
         mới được đặt NGANG HÀNG, ngay sau wrapper 2 cột (ancestor group[2] của
         category_id) -> render thành một section full-width dưới cùng.

         - Loại khách hàng: radio ngang (tick box), giống company_type của core.
         - Mã số thuế (vat) được DỜI xuống group này bằng position="move".
         - Mã khách hàng: readonly khi Trong nước ('1', tự sinh = MST); Nước
           ngoài ('2') và Nội bộ ('3') cho nhập tay. Nước ngoài được onchange
           tự điền sẵn prefix 'NN' (user gõ tiếp 10 chữ số). Chặn write thực sự
           nằm ở create/write trong model; định dạng nước ngoài 'NN'+10 chữ số
           được ràng buộc bởi _check_foreign_customer_code.
         - Mã external không hiển thị (tự sinh).
         ===================================================================== -->
    <record id="view_partner_form_customer_code" model="ir.ui.view">
        <field name="name">res.partner.form.customer.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']/ancestor::group[2]" position="after">
                <group name="partner_customer_group" string="Phân loại khách hàng">
                    <field name="customer_type" widget="radio"
                           options="{'horizontal': true}"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='partner_customer_group']" position="inside">
                <xpath expr="//field[@name='vat']" position="move"/>
                <field name="customer_code" readonly="customer_type == '1'"/>
                <!-- Định danh người mua cá nhân: chỉ hiện với Cá nhân
                     (is_company = False); Công ty dùng MST nên ẩn. -->
                <field name="cccd_no" invisible="is_company"/>
                <field name="passport_no" invisible="is_company"/>
            </xpath>
        </field>
    </record>

</odoo>
