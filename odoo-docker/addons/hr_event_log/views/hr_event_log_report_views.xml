<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_event_log_active_report_list" model="ir.ui.view">
        <field name="name">hr.event.log.active.report.list</field>
        <field name="model">hr.event.log.active.report</field>
        <field name="arch" type="xml">
            <list string="Active Roster" create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="event_type" string="Latest Event"/>
                <field name="effective_date"/>
            </list>
        </field>
    </record>

    <record id="action_hr_event_log_active_report" model="ir.actions.act_window">
        <field name="name">Active Data</field>
        <field name="res_model">hr.event.log.active.report</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_hr_event_log_leaver_report_list" model="ir.ui.view">
        <field name="name">hr.event.log.leaver.report.list</field>
        <field name="model">hr.event.log.leaver.report</field>
        <field name="arch" type="xml">
            <list string="Leavers" create="0" edit="0" delete="0" default_order="effective_date desc">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="effective_date" string="Resignation Date"/>
                <field name="last_working_day"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="action_hr_event_log_leaver_report" model="ir.actions.act_window">
        <field name="name">Leavers</field>
        <field name="res_model">hr.event.log.leaver.report</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
