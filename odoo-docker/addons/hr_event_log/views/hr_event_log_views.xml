<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_event_log_list" model="ir.ui.view">
        <field name="name">hr.event.log.list</field>
        <field name="model">hr.event.log</field>
        <field name="arch" type="xml">
            <list string="HR Event Log" create="1" edit="0" delete="0">
                <field name="event_ref"/>
                <field name="employee_id"/>
                <field name="event_type"/>
                <field name="effective_date"/>
                <field name="department_id"/>
                <field name="job_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_event_log_form" model="ir.ui.view">
        <field name="name">hr.event.log.form</field>
        <field name="model">hr.event.log</field>
        <field name="arch" type="xml">
            <form string="HR Event">
                <header>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                    <button name="action_create_employee_user" type="object"
                            string="Create Login Account"
                            invisible="event_type != 'new_hire' or not employee_id"/>
                </header>
                <sheet>
                    <group>
                        <field name="event_ref" readonly="1"/>
                        <field name="event_type"/>
                        <field name="employee_id" required="event_type != 'new_hire'"/>
                        <field name="new_employee_name"
                               invisible="event_type != 'new_hire' or employee_id"
                               required="event_type == 'new_hire' and not employee_id"/>
                        <field name="effective_date"/>
                    </group>

                    <group string="New Hire Details" invisible="event_type != 'new_hire'" col="2">
                        <field name="department_id"/>
                        <field name="job_id"/>
                        <field name="work_location_id"/>
                        <field name="team"/>
                        <field name="job_offer_text"/>
                        <field name="classification_id"/>
                        <field name="job_title_group_id"/>
                        <field name="work_phone"/>
                        <field name="work_email"/>
                        <field name="personal_email"/>
                        <field name="address"/>
                        <field name="birthday"/>
                        <field name="gender"/>
                        <field name="identification_id"/>
                        <field name="education_general"/>
                        <field name="education_level"/>
                        <field name="contract_type_id"/>
                        <field name="contract_date_start"/>
                        <field name="contract_date_end"/>
                    </group>

                    <group string="Transfer / Return to Work Details"
                           invisible="event_type not in ('transfer', 'return_to_work')">
                        <field name="department_id"/>
                        <field name="job_id"/>
                        <field name="team"/>
                    </group>

                    <group string="Promotion Details" invisible="event_type != 'promotion'">
                        <field name="job_id"/>
                        <field name="job_title_group_id"/>
                    </group>

                    <group string="Salary / Contract Change Details"
                           invisible="event_type != 'salary_contract_change'">
                        <field name="contract_type_id"/>
                        <field name="contract_date_start"/>
                        <field name="contract_date_end"/>
                        <field name="salary_scale_id"/>
                        <field name="salary_scale_group_id"/>
                        <field name="salary_grade_id"/>
                    </group>

                    <group string="Maternity Leave Details" invisible="event_type != 'maternity_leave'">
                        <field name="leave_start_date"/>
                        <field name="leave_expected_return_date"/>
                        <field name="leave_coverage_employee_id"/>
                        <field name="is_unplanned_leave"/>
                    </group>

                    <group string="Extended Leave Details" invisible="event_type != 'extended_leave'">
                        <field name="leave_start_date"/>
                        <field name="leave_expected_return_date"/>
                        <field name="leave_paid"/>
                        <field name="is_unplanned_leave"/>
                    </group>

                    <group string="Resignation Details" invisible="event_type != 'resignation'">
                        <field name="last_working_day"/>
                        <field name="resignation_reason_type"/>
                    </group>

                    <group>
                        <field name="notes" invisible="event_type == 'new_hire'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_event_log" model="ir.actions.act_window">
        <field name="name">HR Event Log</field>
        <field name="res_model">hr.event.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
