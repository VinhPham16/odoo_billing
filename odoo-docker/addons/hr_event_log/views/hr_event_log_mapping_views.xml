<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_event_log_mapping_list" model="ir.ui.view">
        <field name="name">hr.event.log.mapping.list</field>
        <field name="model">hr.event.log.mapping</field>
        <field name="arch" type="xml">
            <list string="HR Event Log Master Data" editable="bottom">
                <field name="category"/>
                <field name="name"/>
                <field name="sequence" widget="handle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_hr_event_log_mapping" model="ir.actions.act_window">
        <field name="name">HR Event Log Master Data</field>
        <field name="res_model">hr.event.log.mapping</field>
        <field name="view_mode">list</field>
        <field name="help">
            Configure the lookup values used in HR Event forms - Labor
            Classification, Job Title Group, Contract Type, Salary Scale,
            Salary Scale Group, and Salary Grade. Department, Job Position,
            and Work Location are managed under their own standard Odoo
            HR settings, not here. Sort by clicking the Category column,
            or use the search bar's built-in filters (Odoo auto-generates
            these from the model's fields).
        </field>
    </record>
</odoo>
