<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Khổ giấy A4 dọc, lề 7mm/8mm (khớp bản preview đã duyệt).
         ================================================================ -->
    <record id="paperformat_draft_invoice" model="report.paperformat">
        <field name="name">Hóa đơn draft VNPost (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">12</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <!-- ================================================================
         Report action (template riêng, KHÔNG dùng report core).
         ================================================================ -->
    <record id="action_report_draft_invoice" model="ir.actions.report">
        <field name="name">Hóa đơn (Draft/Proforma)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_send_draft_invoice.report_draft_invoice</field>
        <field name="report_file">account_send_draft_invoice.report_draft_invoice</field>
        <field name="paperformat_id" ref="paperformat_draft_invoice"/>
        <field name="print_report_name">'HoaDon_Draft_%s' % (object.partner_id.name or object.id)</field>
    </record>

    <!-- ================================================================
         Template gốc: BẮT BUỘC bọc mỗi hóa đơn trong <div class="article">
         để Odoo (_prepare_html) nhận diện body và bọc vào web.minimal_layout
         (cấp meta charset + base href + font report Lato/Noto). Thiếu class
         này Odoo gửi wkhtmltopdf một body không <head> -> mojibake + mất ảnh.
         ================================================================ -->
    <template id="report_draft_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article"
                     t-att-data-oe-model="'account.move'"
                     t-att-data-oe-id="o.id"
                     t-att-data-oe-lang="o.partner_id.lang">
                    <t t-call="account_send_draft_invoice.report_draft_invoice_style"/>
                    <t t-call="account_send_draft_invoice.report_draft_invoice_document"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ================================================================
         Nội dung một hóa đơn.
         ================================================================ -->
    <template id="report_draft_invoice_document">
        <t t-set="company" t-value="o.company_id"/>
        <t t-set="partner" t-value="o.partner_id.commercial_partner_id or o.partner_id"/>
        <t t-set="show_partner_vat" t-value="o._draft_show_partner_vat()"/>
        <t t-set="company_vat" t-value="(company.vat or '')"/>
        <t t-set="partner_vat" t-value="(partner.vat or '') if show_partner_vat else ''"/>
        <t t-set="lines" t-value="o._draft_product_lines()"/>
        <t t-set="tax_sum" t-value="o._draft_tax_summary()"/>
        <t t-set="totals" t-value="o._draft_totals()"/>
        <t t-set="company_addr"
           t-value="', '.join([p for p in [company.street, company.street2, company.city] if p])"/>
        <t t-set="partner_addr"
           t-value="', '.join([p for p in [partner.street, partner.street2, partner.city, partner.state_id.name if partner.state_id else '', partner.country_id.name if partner.country_id else ''] if p])"/>

        <div class="dinv-page">
            <div class="dinv-provider">
                Giải pháp hóa đơn điện tử được cung cấp bởi Tổng Công ty Bưu điện Việt Nam
                - MST: 0102595740 - Tel: 1900545481
            </div>

            <!-- KHỐI THÔNG TIN: header + người bán/mua chung MỘT khung -->
            <div class="dinv-info">
            <!-- HEADER -->
            <table class="dinv-head"><tr>
                <td class="dinv-head-logo">
                    <img class="dinv-logo" src="/account_send_draft_invoice/static/src/img/logo.png"/>
                </td>
                <td class="dinv-head-title">
                    <div class="dinv-title-vi">HÓA ĐƠN GIÁ TRỊ GIA TĂNG</div>
                    <div class="dinv-title-en">VAT INVOICE</div>
                    <div class="dinv-date">
                        Ngày <span class="dinv-dmy" t-esc="o.invoice_date.strftime('%d') if o.invoice_date else ''"/>
                        tháng <span class="dinv-dmy" t-esc="o.invoice_date.strftime('%m') if o.invoice_date else ''"/>
                        năm <span class="dinv-dmy" t-esc="o.invoice_date.strftime('%Y') if o.invoice_date else ''"/>
                    </div>
                </td>
                <td class="dinv-head-serial">
                    <div>Ký hiệu <i>(Series)</i>: <span t-esc="o.ky_hieu_hddt or ''"/></div>
                    <div>Số <i>(No.)</i>:</div>
                </td>
            </tr></table>

            <!-- NGƯỜI BÁN / NGƯỜI MUA -->
            <div class="dinv-parties">
                <table class="dinv-party-tbl">
                    <tr><td class="dinv-lbl">Đơn vị bán hàng <i>(Sale company)</i>:</td>
                        <td class="dinv-val" colspan="3"><span t-field="company.name"/></td></tr>
                    <tr><td class="dinv-lbl">Địa chỉ <i>(Address)</i>:</td>
                        <td class="dinv-val" colspan="3"><span t-esc="company_addr"/></td></tr>
                    <tr><td class="dinv-lbl">Số tài khoản <i>(Account code)</i>:</td>
                        <td class="dinv-val" colspan="3"></td></tr>
                    <tr>
                        <td class="dinv-lbl">Điện thoại <i>(Tel)</i>:</td>
                        <td class="dinv-val" style="width:28%"><span t-field="company.phone"/></td>
                        <td class="dinv-lbl-mst">MST:</td>
                        <!-- Box MST trên MỘT dòng: không có khoảng trắng giữa các
                             <span> nên các ô dính liền (dùng chung viền), không hở. -->
                        <td class="dinv-val-mst"><t t-foreach="range(14)" t-as="i"><span class="dinv-box" t-esc="company_vat[i] if i &lt; len(company_vat) else ''"/></t></td>
                    </tr>
                </table>
                <table class="dinv-party-tbl">
                    <tr><td class="dinv-lbl">Họ tên người mua hàng <i>(Customer's name)</i>:</td>
                        <td class="dinv-val" colspan="3">
                            <span t-esc="o.partner_id.name if o.partner_id != partner else ''"/>
                        </td></tr>
                    <tr><td class="dinv-lbl">Tên đơn vị <i>(Company)</i>:</td>
                        <td class="dinv-val" colspan="3"><span t-field="partner.name"/></td></tr>
                    <tr><td class="dinv-lbl">Địa chỉ <i>(Address)</i>:</td>
                        <td class="dinv-val" colspan="3"><span t-esc="partner_addr"/></td></tr>
                    <tr><td class="dinv-lbl">Số tài khoản <i>(Account code)</i>:</td>
                        <td class="dinv-val" colspan="3"></td></tr>
                    <tr>
                        <td class="dinv-lbl">Điện thoại <i>(Tel)</i>:</td>
                        <td class="dinv-val" style="width:28%"><span t-field="partner.phone"/></td>
                        <td class="dinv-lbl-mst">MST:</td>
                        <!-- Khách Nội bộ (customer_type=3): partner_vat rỗng -> ô trống -->
                        <td class="dinv-val-mst"><t t-foreach="range(14)" t-as="i"><span class="dinv-box" t-esc="partner_vat[i] if i &lt; len(partner_vat) else ''"/></t></td>
                    </tr>
                    <tr><td class="dinv-lbl">Hình thức thanh toán <i>(Method of payment)</i>:</td>
                        <td class="dinv-val" colspan="3">Chuyển khoản</td></tr>
                    <tr><td class="dinv-lbl">Số hộ chiếu <i>(Passport)</i>:</td><td class="dinv-val"></td>
                        <td class="dinv-lbl">Số CCCD <i>(Citizen ID number)</i>:</td><td class="dinv-val"></td></tr>
                    <tr><td class="dinv-lbl">Mã đơn vị quan hệ ngân sách:</td>
                        <td class="dinv-val" colspan="3"></td></tr>
                </table>
            </div>
            </div>

            <!-- BẢNG CHI TIẾT + watermark nền neo vào đỉnh bảng -->
            <div class="dinv-table-wrap">
                <img class="dinv-bg" src="/account_send_draft_invoice/static/src/img/background.png"/>
                <table class="dinv-lines">
                    <thead>
                        <tr class="dinv-lines-head">
                            <th style="width:4%">Stt<br/><i>(ITEM)</i></th>
                            <th style="width:25%">Tên hàng hóa, dịch vụ<br/><i>(DESCRIPTION)</i></th>
                            <th style="width:7%">Đơn vị tính<br/><i>(UNIT)</i></th>
                            <th style="width:7%">Số lượng<br/><i>(QUANTITY)</i></th>
                            <th style="width:11%">Đơn giá<br/><i>(UNIT PRICE)</i></th>
                            <th style="width:8%">Chiết khấu<br/><i>(DISCOUNT)</i> VND</th>
                            <th style="width:11%">Thành tiền<br/><i>(AMOUNT)</i> VND</th>
                            <th style="width:7%">Thuế suất GTGT<br/><i>(VAT)</i></th>
                            <th style="width:10%">Tiền thuế GTGT<br/><i>(VAT AMOUNT)</i></th>
                            <th style="width:10%">Thành tiền sau thuế<br/><i>(GRAND TOTAL)</i></th>
                        </tr>
                        <tr class="dinv-lines-colnum">
                            <td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td>
                            <td>7=4x5-6</td><td>8</td><td>9=7*8</td><td>10=7+9</td>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="row" t-value="0"/>
                        <t t-foreach="lines" t-as="line">
                            <t t-set="row" t-value="row + 1"/>
                            <tr>
                                <t t-if="line.display_type == 'product'">
                                    <t t-set="rate" t-value="o._draft_line_vat_rate(line)"/>
                                    <t t-set="amt" t-value="o._draft_line_amounts(line)"/>
                                    <td class="dinv-c" t-esc="row"/>
                                    <td class="dinv-l"><span t-esc="line.line_description or line.name"/></td>
                                    <td class="dinv-c"><span t-field="line.product_uom_id.name"/></td>
                                    <td class="dinv-r"><span t-esc="'{:g}'.format(line.quantity)"/></td>
                                    <td class="dinv-r" t-esc="o._draft_fmt_vnd(amt['unit'])"/>
                                    <td class="dinv-r" t-esc="o._draft_fmt_vnd(amt['discount'], blank_zero=True)"/>
                                    <td class="dinv-r" t-esc="o._draft_fmt_vnd(amt['base'])"/>
                                    <td class="dinv-c" t-esc="'{:g}%'.format(rate) if rate is not None else ''"/>
                                    <td class="dinv-r" t-esc="o._draft_fmt_vnd(amt['tax'])"/>
                                    <td class="dinv-r" t-esc="o._draft_fmt_vnd(amt['total'])"/>
                                </t>
                                <t t-else="">
                                    <td class="dinv-c" t-esc="row"/>
                                    <td class="dinv-l"><span t-esc="line.name"/></td>
                                    <td class="dinv-c"></td><td class="dinv-r"></td><td class="dinv-r"></td>
                                    <td class="dinv-r"></td><td class="dinv-r"></td><td class="dinv-c"></td>
                                    <td class="dinv-r"></td><td class="dinv-r"></td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="dinv-total-row">
                            <td colspan="5" class="dinv-r"><b>Cộng <i>(Total)</i>:</b></td>
                            <td></td>
                            <td class="dinv-r" t-esc="o._draft_fmt_vnd(totals['untaxed'])"/>
                            <td></td>
                            <td class="dinv-r" t-esc="o._draft_fmt_vnd(totals['tax'])"/>
                            <td class="dinv-r" t-esc="o._draft_fmt_vnd(totals['total'])"/>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="dinv-inwords">
                Số tiền viết bằng chữ <i>(In words)</i>:
                <b><span t-esc="o._draft_amount_in_words()"/></b>
            </div>

            <table class="dinv-taxsum">
                <tr><td class="dinv-ts-lbl">Tổng tiền không chịu thuế:</td><td class="dinv-ts-val"></td>
                    <td class="dinv-ts-lbl"></td><td class="dinv-ts-val"></td></tr>
                <tr><td class="dinv-ts-lbl">Tổng tiền không kê khai tính nộp thuế:</td><td class="dinv-ts-val"></td>
                    <td class="dinv-ts-lbl"></td><td class="dinv-ts-val"></td></tr>
                <tr><td class="dinv-ts-lbl">Tổng tiền chịu thuế 0%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[0]['base'], blank_zero=True)"/>
                    <td class="dinv-ts-lbl"></td><td class="dinv-ts-val"></td></tr>
                <tr><td class="dinv-ts-lbl">Tổng tiền chịu thuế 5%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[5]['base'], blank_zero=True)"/>
                    <td class="dinv-ts-lbl">Tổng tiền thuế GTGT 5%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[5]['tax'], blank_zero=True)"/></tr>
                <tr><td class="dinv-ts-lbl">Tổng tiền chịu thuế 8%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[8]['base'], blank_zero=True)"/>
                    <td class="dinv-ts-lbl">Tổng tiền thuế GTGT 8%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[8]['tax'], blank_zero=True)"/></tr>
                <tr><td class="dinv-ts-lbl">Tổng tiền chịu thuế 10%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[10]['base'], blank_zero=True)"/>
                    <td class="dinv-ts-lbl">Tổng tiền thuế GTGT 10%:</td>
                    <td class="dinv-ts-val" t-esc="o._draft_fmt_vnd(tax_sum[10]['tax'], blank_zero=True)"/></tr>
            </table>

            <table class="dinv-sign"><tr>
                <td><div class="dinv-sign-title">Người mua hàng <i>(Buyer)</i></div>
                    <div class="dinv-sign-sub">(Ký, ghi rõ họ, tên)</div>
                    <div class="dinv-sign-sub"><i>(Signature, full name)</i></div></td>
                <td><div class="dinv-sign-title">Người bán hàng <i>(Saler)</i></div>
                    <div class="dinv-sign-sub">(Ký, ghi rõ họ, tên)</div>
                    <div class="dinv-sign-sub"><i>(Signature, full name)</i></div></td>
            </tr></table>

            <div class="dinv-lookup">
                Tra cứu hóa đơn điện tử tại Website: https://tracuuhoadon.vnpost.vn - Mã tra cứu hóa đơn:
            </div>
        </div>
    </template>

    <!-- ================================================================
         CSS (khớp bản preview đã duyệt).
         ================================================================ -->
    <template id="report_draft_invoice_style">
        <style>
            /* Font: Arial/Liberation Sans không có trên container Linux -> rơi về
               DejaVu Sans (phủ đầy glyph tiếng Việt cả thường lẫn ĐẬM, đồng nhất).
               Lato-Bold thiếu vài glyph VN nên bold bị lệch font -> tránh. */
            .dinv-page { position:relative; z-index:0;
                font-family:Arial,"Liberation Sans","DejaVu Sans","Odoo Unicode Support Noto",sans-serif;
                font-size:11px; color:#000; line-height:1.3; }

            /* QUAN TRỌNG: report assets của Odoo nạp Bootstrap, nó gán
               'table { margin-bottom:1rem }' -> chèn khoảng hở giữa các khối,
               làm GÃY khung liền và lệch scaling. Reset table ở đây. */
            .dinv-page table { margin:0; border-spacing:0; }

            .dinv-provider { text-align:center; font-style:italic; font-size:10px;
                border-bottom:1px dashed #000; padding-bottom:2px; margin-bottom:4px; }

            /* Khung chung bao HEADER + người bán/mua: CHỈ 1 viền cho cả block,
               không viền từng ô bên trong. */
            .dinv-info { border:1.5px solid #000; border-bottom:none; }

            /* HEADER: không viền ô, chỉ 1 đường kẻ phân cách xuống khối dưới */
            .dinv-head { width:100%; border-collapse:collapse; border:none;
                border-bottom:1px solid #000; }
            .dinv-head td { border:0; vertical-align:middle; padding:4px 10px; }
            .dinv-head-logo { width:26%; text-align:center; }
            .dinv-logo { height:60px; width:auto; margin-left:-10px; }
            /* specificity .dinv-head td.dinv-head-title để thắng .dinv-head td padding */
            .dinv-head td.dinv-head-title { text-align:center; padding:4mm 10mm 10mm 0mm; }
            .dinv-title-vi { color:#0a4a8f; font-size:21px; font-weight:700; }
            .dinv-title-en { color:#0a4a8f; font-size:16px; font-weight:700; margin-top:2px; }
            .dinv-date { padding-top:10px; font-size:12px; }
            .dinv-dmy { border-bottom:1px solid #000; padding:0 8px; font-weight:normal; }
            .dinv-head-serial { width:22%; font-size:12px; }
            .dinv-head-serial div { margin-bottom:9px; }

            /* Khối người bán/mua: KHÔNG viền ô, chỉ gạch chân chấm cho ô điền.
               Dùng border-collapse:separate để wkhtmltopdf KHÔNG kéo gạch chân
               của ô .dinv-val lan sang ô nhãn .dinv-lbl (lỗi chỉ xảy ra trong PDF). */
            .dinv-parties { border:none; }
            .dinv-party-tbl { width:100%; border-collapse:separate; border-spacing:0; }
            .dinv-party-tbl + .dinv-party-tbl { border-top:1px solid #000; }
            .dinv-party-tbl td { border:0; padding:3px 6px; font-size:11px; vertical-align:bottom; }
            .dinv-lbl { white-space:nowrap; width:1%; }
            .dinv-party-tbl td.dinv-val { border-bottom:1px dotted #666; }
            .dinv-lbl-mst { white-space:nowrap; text-align:right; width:1%; }
            /* font-size:0 triệt khoảng trắng giữa các ô MST (do t-foreach xuống
               dòng sinh ra) để các ô DÍNH liền nhau (dùng chung viền), không hở. */
            .dinv-val-mst { white-space:nowrap; width:1%; font-size:0; }
            .dinv-box { display:inline-block; width:14px; height:16px; line-height:16px; border:1px solid #000;
                text-align:center; margin-left:-1px; font-size:11px; vertical-align:middle; }

            /* Vùng bảng: watermark nền neo vào đỉnh bảng.
               KHÔNG dùng transform để căn giữa (wkhtmltopdf/QtWebKit bỏ qua
               CSS transform -> ảnh bị lệch phải). Căn giữa bằng left + width.
               z-index:-1 (trong stacking context .dinv-page) để ảnh nền luôn NẰM
               DƯỚI mọi nội dung, kể cả khi ảnh tràn xuống các block phía dưới. */
            .dinv-table-wrap { position:relative; }
            .dinv-bg { position:absolute; top:0; left:1%; width:98%; z-index:-1; opacity:1; }

            /* Bảng chi tiết: viền ngoài đậm, lưới ô 1px; font-size đặt trực tiếp
               trên th/td vì QtWebKit không kế thừa font-size vào ô bảng */
            .dinv-lines { width:100%; border-collapse:collapse; border:1.5px solid #000; background:transparent; }
            .dinv-lines th, .dinv-lines td { border:1px solid #000; padding:4px 5px;
                font-size:11px; line-height:1.3; vertical-align:top; }
            .dinv-lines-head th { background:#eef2f7; font-size:10px; text-align:center;
                vertical-align:middle; font-weight:700; }
            .dinv-lines-colnum td { text-align:center; font-size:9px; background:#f7f7f7; }
            .dinv-c{ text-align:center; } .dinv-l{ text-align:left; } .dinv-r{ text-align:right; }
            .dinv-empty td { height:20px; }
            .dinv-total-row td { font-weight:700; }

            /* Số tiền bằng chữ + tổng theo mức thuế */
            .dinv-inwords { border:1.5px solid #000; border-top:none; padding:4px 6px; font-size:11px; }
            /* Khối tổng theo mức thuế: BỎ hết lưới ô bên trong, chỉ giữ viền
               khung ngoài để nối liền khung tổng thể. */
            .dinv-taxsum { width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:none; }
            .dinv-taxsum td { border:0; padding:3px 6px; font-size:11px; }
            .dinv-ts-lbl { width:30%; } .dinv-ts-val { width:20%; text-align:right; }

            /* Chữ ký */
            .dinv-sign { width:100%; border-collapse:collapse; border:1.5px solid #000; border-top:none; }
            .dinv-sign td { width:50%; text-align:center; padding:8px 6px 64px; vertical-align:top; font-size:11px; }
            .dinv-sign-title { font-weight:700; } .dinv-sign-sub { font-size:10px; }
            .dinv-lookup { font-size:10px; margin-top:4px; }
        </style>
    </template>
</odoo>
