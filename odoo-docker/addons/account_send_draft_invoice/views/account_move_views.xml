<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_send_draft" model="ir.ui.view">
        <field name="name">account.move.form.send.draft</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!--
                Thêm nút "Send Draft" vào header, đặt trước nút Post.
                Chỉ hiện với hóa đơn bán (out_invoice/out_refund/out_receipt)
                đang ở trạng thái draft. Vendor bill và Journal Entry không thấy.
            -->
            <xpath expr="//header/button[@name='action_post'][1]" position="before">
                <button name="action_send_draft_invoice" type="object"
                        string="Send Draft"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>
