<odoo>
    <record id="view_move_form_contract_fields" model="ir.ui.view">
        <field name="name">account.move.form.contract.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Thông tin hợp đồng">
                    <field name="x_contract_number"/>
                    <field name="x_contract_sign_date"/>
                    <field name="x_contract_effective_date"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='invoice_date_due']" position="after">
                <field name="installment_due_status" widget="badge"
                       decoration-warning="installment_due_status == 'partially_due'"
                       decoration-danger="installment_due_status == 'fully_due'"
                       decoration-success="installment_due_status == 'paid'"
                       decoration-muted="installment_due_status in ('not_due','not_applicable')"/>
                <field name="amount_due_now"
                       invisible="installment_due_status not in ('partially_due','fully_due')"/>
                <field name="amount_not_due_yet"
                       invisible="installment_due_status != 'partially_due'"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_contract_fields" model="ir.ui.view">
        <field name="name">account.move.tree.contract.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="installment_due_status" widget="badge"
                       decoration-warning="installment_due_status == 'partially_due'"
                       decoration-danger="installment_due_status == 'fully_due'"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>