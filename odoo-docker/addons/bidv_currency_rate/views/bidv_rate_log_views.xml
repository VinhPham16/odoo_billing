<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bidv_rate_log_list" model="ir.ui.view">
        <field name="name">bidv.exchange.rate.log.list</field>
        <field name="model">bidv.exchange.rate.log</field>
        <field name="arch" type="xml">
            <list string="BIDV Rate Logs" decoration-success="state == 'success'"
                  decoration-warning="state == 'waiting'"
                  decoration-danger="state in ('stopped_stale','stopped_failed','stopped_anomaly')">
                <field name="create_date"/>
                <field name="date"/>
                <field name="provider_hour"/>
                <field name="namerecord"/>
                <field name="source"/>
                <field name="state"/>
                <field name="forced"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_bidv_rate_log_form" model="ir.ui.view">
        <field name="name">bidv.exchange.rate.log.form</field>
        <field name="model">bidv.exchange.rate.log</field>
        <field name="arch" type="xml">
            <form string="BIDV Rate Log">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="state"/>
                            <field name="forced"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="provider_day"/>
                            <field name="provider_hour"/>
                            <field name="namerecord"/>
                        </group>
                    </group>
                    <field name="message"/>
                    <field name="line_ids">
                        <list>
                            <field name="currency_code"/>
                            <field name="value_vnd"/>
                            <field name="prev_value_vnd"/>
                            <field name="deviation_pct"/>
                        </list>
                    </field>
                    <group string="Raw response">
                        <field name="raw_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bidv_rate_log" model="ir.actions.act_window">
        <field name="name">BIDV Rate Logs</field>
        <field name="res_model">bidv.exchange.rate.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bidv_rate_log"
              name="BIDV Rate Logs"
              parent="account.menu_finance_configuration"
              action="action_bidv_rate_log"
              sequence="100"/>
</odoo>
