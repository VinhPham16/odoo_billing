<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_company_filter" model="ir.ui.view">
        <field name="name">account.move.form.company.filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <!--
                    Chỉ áp cho hóa đơn KHÁCH HÀNG (out_invoice / out_refund / out_receipt):
                    lọc theo customer_rank > 0 => lấy đúng partner được tạo từ luồng Customer
                    (Odoo set customer_rank = 1 khi tạo với context res_partner_search_mode='customer'),
                    KHÔNG loại nhầm khách hàng là cá nhân.
                    Vendor bill (in_invoice / in_refund / in_receipt) và entry rơi vào nhánh
                    else [] => domain rỗng => giữ nguyên như core.
                -->
                <attribute name="domain">[('customer_rank', '>', 0)] if move_type in ('out_invoice', 'out_refund', 'out_receipt') else []</attribute>
            </field>
        </field>
    </record>
</odoo>
