<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form hóa đơn: Department nằm ngay dưới Salesperson trong tab
         "Other Info" > group "Invoice", để thấy rõ quan hệ tự-điền giữa
         hai field. -->
    <record id="view_move_form_department" model="ir.ui.view">
        <field name="name">account.move.form.department</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//field[@name='invoice_user_id']" position="after">
                <field name="department_id"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>

    <!-- List hóa đơn: cột ẩn mặc định (optional="hide"), người dùng tự bật
         qua nút chọn cột - giống cách core làm với Salesperson. -->
    <record id="view_invoice_tree_department" model="ir.ui.view">
        <field name="name">account.move.list.department</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="department_id" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Search hóa đơn: tìm theo phòng ban + Group By "Department"
         (đặt cạnh Group By "Salesperson"). -->
    <record id="view_account_invoice_filter_department" model="ir.ui.view">
        <field name="name">account.move.search.department</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <field name="invoice_user_id" position="after">
                <field name="department_id" string="Department"/>
            </field>
            <filter name="salesperson" position="after">
                <filter string="Department" name="department"
                        domain="[]" context="{'group_by': 'department_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
