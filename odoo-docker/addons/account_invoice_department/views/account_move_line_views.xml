<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Journal Items: thêm cột Department (ẩn mặc định) để lấy số liệu
         doanh thu theo phòng ban trực tiếp trên bút toán. -->
    <record id="view_move_line_tree_department" model="ir.ui.view">
        <field name="name">account.move.line.list.department</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="department_id" optional="hide" readonly="1"/>
            </field>
        </field>
    </record>

    <!-- Search Journal Items: lọc + Group By theo phòng ban. Kết hợp với
         filter "Sales" / "P&L Accounts" sẵn có là ra được doanh thu từng
         phòng ban theo kỳ. -->
    <record id="view_account_move_line_filter_department" model="ir.ui.view">
        <field name="name">account.move.line.search.department</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="department_id"/>
            </field>
            <filter name="group_by_partner" position="after">
                <filter string="Department" name="group_by_department"
                        domain="[]" context="{'group_by': 'department_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
